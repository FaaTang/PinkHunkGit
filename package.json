{
  "name": "pink-hunk-git",
  "displayName": "Pink Hunk Git",
  "description": "IDEA-like Git commit panel for VS Code",
  "version": "2.0.20",
  "publisher": "FaaTang",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copyIdeaGitUi.openCommit",
        "title": "Open Commit",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.openPush",
        "title": "Open Push",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.openClone",
        "title": "Clone Repository",
        "category": "Pink Hunk Git",
        "icon": "$(repo-clone)"
      },
      {
        "command": "copyIdeaGitUi.updateAllRepositories",
        "title": "Update All Git Repositories",
        "category": "Pink Hunk Git",
        "icon": "$(sync)"
      },
      {
        "command": "copyIdeaGitUi.showDiff",
        "title": "Show Diff",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.diffNextChangeOrFile",
        "title": "Diff: Next Change or Next File",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.diffPreviousChangeOrFile",
        "title": "Diff: Previous Change or Previous File",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.openFile",
        "title": "Open File",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.rollback",
        "title": "Rollback",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.addToGit",
        "title": "Add to Git",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.commit",
        "title": "Commit",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.commitAndPush",
        "title": "Commit and Push",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.fastPush",
        "title": "Fast Push",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.openExplorer",
        "title": "Open Explorer",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.installKeybindings",
        "title": "Install IDEA Keybindings",
        "category": "Pink Hunk Git"
      },
      {
        "command": "copyIdeaGitUi.toggleSoftExclusiveGit",
        "title": "Toggle Soft Exclusive Git",
        "category": "Pink Hunk Git"
      }
    ],
    "configuration": {
      "title": "Pink Hunk Git",
      "properties": {
        "copyIdeaGitUi.softExclusiveGit": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, disables built-in Git autofetch and autorefresh in the current workspace so Pink Hunk Git is less likely to hit index.lock races. Keeps vscode.git enabled (required by this extension). The Commit panel still refreshes on file changes via its own watchers."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copyIdeaGitUi",
          "title": "Commit",
          "icon": "media/commit.svg"
        }
      ]
    },
    "views": {
      "copyIdeaGitUi": [
        {
          "type": "webview",
          "id": "copyIdeaGitUi.commitView",
          "name": "Commit",
          "icon": "media/commit.svg",
          "contextualTitle": "Commit"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copyIdeaGitUi.openClone",
          "when": "view == copyIdeaGitUi.commitView",
          "group": "navigation@0"
        },
        {
          "command": "copyIdeaGitUi.updateAllRepositories",
          "when": "view == copyIdeaGitUi.commitView",
          "group": "navigation@1"
        },
        {
          "command": "copyIdeaGitUi.openExplorer",
          "when": "view == copyIdeaGitUi.commitView",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "copyIdeaGitUi.openCommit",
        "key": "ctrl+k",
        "mac": "cmd+k"
      },
      {
        "command": "copyIdeaGitUi.openPush",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "copyIdeaGitUi.updateAllRepositories",
        "key": "ctrl+t",
        "mac": "cmd+t"
      },
      {
        "command": "copyIdeaGitUi.showDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "view == copyIdeaGitUi.commitView && copyIdeaGitUi.hasSelection"
      },
      {
        "command": "copyIdeaGitUi.openFile",
        "key": "f4",
        "when": "copyIdeaGitUi.hasSelection"
      },
      {
        "command": "copyIdeaGitUi.diffPreviousChangeOrFile",
        "key": "f6",
        "when": "inDiffEditor"
      },
      {
        "command": "copyIdeaGitUi.diffNextChangeOrFile",
        "key": "f7",
        "when": "inDiffEditor"
      },
      {
        "command": "copyIdeaGitUi.rollback",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "view == copyIdeaGitUi.commitView && copyIdeaGitUi.hasSelection"
      },
      {
        "command": "copyIdeaGitUi.addToGit",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "view == copyIdeaGitUi.commitView"
      },
      {
        "command": "copyIdeaGitUi.commit",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "view == copyIdeaGitUi.commitView"
      },
      {
        "command": "copyIdeaGitUi.commitAndPush",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "view == copyIdeaGitUi.commitView"
      },
      {
        "command": "copyIdeaGitUi.fastPush",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "package": "vsce package --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FaaTang/PinkHunkGit.git"
  },
  "bugs": {
    "url": "https://github.com/FaaTang/PinkHunkGit/issues"
  },
  "homepage": "https://github.com/FaaTang/PinkHunkGit#readme",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.3.3"
  }
}
